{
	"name": "nuxt-smartness-ui",
	"imageName": "smartness-ui-playground",
	"type": "module",
	"version": "1.19.0",
	"private": true,
	"packageManager": "pnpm@12.23.0",
	"description": "Nuxt Smartness UI",
	"author": "Smartness",
	"exports": {
		".": {
			"import": "./nuxt.config.ts"
		},
		"./eslint": {
			"types": "./eslint.preset.d.ts",
			"import": "./eslint.preset.mjs"
		},
		"./types": {
			"types": "./types.ts",
			"import": "./types.ts"
		},
		"./*": "./*"
	},
	"main": "./nuxt.config.ts",
	"types": "./types.ts",
	"scripts": {
		"postinstall": "nuxt prepare",
		"dev": "nuxi dev",
		"generate:colors": "jiti scripts/generate-colors.ts",
		"play": "nuxi dev .playground",
		"dev:playground": "nuxi dev .playground",
		"prepare:playground": "nuxt prepare .playground",
		"build": "nuxt prepare && nuxt build .playground",
		"generate": "nuxt prepare && nuxt generate .playground",
		"preview": "nuxt preview .playground",
		"lint": "nuxt prepare && eslint ./app",
		"lint:fix": "nuxt prepare && eslint ./app --fix",
		"release": "bash ./scripts/release.sh"
	},
	"peerDependencies": {
		"maplibre-gl": "^5.21.0"
	},
	"dependencies": {
		"@chenglou/pretext": "^0.0.9",
		"@iconify-json/circle-flags": "^1.2.14",
		"@iconify-json/lucide": "^1.2.159",
		"@iconify-json/ph": "^1.2.2",
		"@internationalized/date": "^3.12.4",
		"@nuxt/fonts": "^1.2.0",
		"@nuxt/ui": "^4.13.1",
		"@nuxtjs/mdc": "^0.23.4",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/charts": "^1.5.0",
		"@vuepic/vue-datepicker": "^14.1.0",
		"@vueuse/core": "^15.1.0",
		"@vueuse/nuxt": "^15.1.0",
		"date-fns": "^4.4.0",
		"echarts": "^6.1.0",
		"libphonenumber-js": "^1.13.17",
		"maplibre-gl": "^5.24.0",
		"maska": "^3.2.2",
		"tailwindcss": "^4.3.5",
		"vue": "^3.5.46",
		"vue-router": "^5.5.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.5.1",
		"@nuxt/eslint": "^1.17.0",
		"bumpp": "^12.3.0",
		"changelogen": "^0.6.2",
		"eslint": "^10.15.0",
		"nuxt": "^4.7.0",
		"typescript": "^6.0.3"
	}
}
